def site_coordinates(meta: dict[str, Any], timezone: str, index: int = 0) -> tuple[float, float]:
    lat = nested_number(meta, "lat") or nested_number(meta, "latitude")
    lng = nested_number(meta, "lng") or nested_number(meta, "longitude") or nested_number(meta, "lon")
    if lat != 0 or lng != 0:
        return round(lat, 4), round(lng, 4)
    if timezone in TIMEZONE_COORDS:
        base_lat, base_lng = TIMEZONE_COORDS[timezone]
        offset = (index % 5) * 0.4
        return round(base_lat + (offset if index % 2 == 0 else -offset), 4), round(base_lng + offset, 4)
    return 0.0, 0.0


def is_notifications_enabled() -> bool:
    try:
        shell_file = Path.home() / ".config" / "omarchy" / "shell.json"
        if shell_file.is_file():
            data = json.loads(shell_file.read_text(encoding="utf-8"))
            layout = data.get("bar", {}).get("layout", {})
            for section in ("left", "center", "right"):
                for w in layout.get(section, []):
                    if isinstance(w, dict) and w.get("id") == "larrywcox.site-thread":
                        if "enableNotifications" in w:
                            return bool(w["enableNotifications"])
    except Exception:
        pass
    return True


def track_issues(sites: list[dict[str, Any]], devices: list[dict[str, Any]], is_demo: bool = False, partial_devices: bool = False) -> list[dict[str, Any]]:
    now = int(time.time())
    if is_demo:
        return [
            {
                "id": "site:warehouse:down",
                "type": "site_down",
                "title": "Warehouse site unreachable",
                "site": "Warehouse",
                "severity": "critical",
                "active": True,
                "startedAt": now - 1080,
                "durationSeconds": 1080,
            },
            {
                "id": "site:office:backup",
                "type": "backup_wan",
                "title": "Main Office secondary WAN failover",
                "site": "Main Office",
                "severity": "warning",
                "active": False,
                "startedAt": now - 3600,
                "resolvedAt": now - 2400,
                "durationSeconds": 1200,
            },
            {
                "id": "device:sw:update",
                "type": "device_offline",
                "title": "USW Pro 24 PoE rebooted (Firmware update)",
                "site": "Main Office",
                "model": "USW Pro 24 PoE",
                "severity": "info",
                "active": False,
                "startedAt": now - 14400,
                "resolvedAt": now - 14100,
                "durationSeconds": 300,
            },
        ]

    active_now: dict[str, dict[str, Any]] = {}
    for s in sites:
        st = str(s.get("status", "up"))
        sid = str(s.get("id", ""))
        sname = str(s.get("name", "Site"))
        if st == "down":
            key = f"site:{sid}:down"
            active_now[key] = {
                "id": key,
                "type": "site_down",
                "title": f"{sname} site unreachable",
                "site": sname,
                "siteId": sid,
                "severity": "critical",
                "active": True,
                "startedAt": now,
            }
        elif st == "backup":
            key = f"site:{sid}:backup"
            active_now[key] = {
                "id": key,
                "type": "backup_wan",
                "title": f"{sname} on backup WAN",
                "site": sname,
                "siteId": sid,
                "severity": "warning",
                "active": True,
                "startedAt": now,
            }

    online_device_keys: set[str] = set()
    online_device_names: set[tuple[str, str]] = set()
    for d in devices:
        did = str(d.get("id", ""))
        dname = str(d.get("name", "Device"))
        dsite = str(d.get("site", ""))
        if not d.get("online", True):
            key = f"device:{did}:offline"
            active_now[key] = {
                "id": key,
                "type": "device_offline",
                "title": f"{dname} offline",
                "site": dsite,
                "model": str(d.get("model", "")),
                "severity": "critical",
                "active": True,
                "startedAt": now,
            }
        else:
            if did:
                online_device_keys.add(f"device:{did}:offline")
                online_device_keys.add(f"device:{did.lower()}:offline")
                online_device_keys.add(f"device:{did.upper()}:offline")
            dmac = re.sub(r"[^0-9a-fA-F]", "", str(d.get("mac", "")))
            if dmac:
                online_device_keys.add(f"device:{dmac.upper()}:offline")
                online_device_keys.add(f"device:{dmac.lower()}:offline")
            if dname:
                online_device_names.add((dname.strip().lower(), dsite.strip().lower()))
                online_device_names.add((dname.strip().lower(), ""))

    history: list[dict[str, Any]] = []
    if ISSUES_FILE.is_file():
        try:
            raw = decode_json(ISSUES_FILE.read_text(encoding="utf-8"))
            if isinstance(raw, list):
                history = [item for item in raw if isinstance(item, dict) and "id" in item]
        except Exception:
            history = []

    active_history = {str(item["id"]): item for item in history if item.get("active")}
    result_active: list[dict[str, Any]] = []
    for key, cur in active_now.items():
        if key in active_history:
            prev = active_history[key]
            started_at = int(prev.get("startedAt", now))
            cur["startedAt"] = started_at
            cur["durationSeconds"] = max(1, now - started_at)
        else:
            cur["durationSeconds"] = 1
            if not is_demo and is_notifications_enabled() and cur.get("type") in ("site_down", "backup_wan"):
                try:
                    subprocess.run(
                        [
                            "notify-send",
                            "--app-name=UniFi SiteThread",
                            "-i",
                            "network-wired",
                            "-u",
                            "critical" if cur.get("severity") == "critical" else "normal",
                            f"UniFi Alert: {cur.get('site', 'Site')}",
                            f"{cur.get('title', 'Outage detected')}",
                        ],
                        check=False,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                    )
                except Exception:
                    pass
        result_active.append(cur)

    result_resolved: list[dict[str, Any]] = []
    for prev in history:
        pid = str(prev.get("id", ""))
        was_active = bool(prev.get("active", False))
        if was_active and pid not in active_now:
            prev_title = str(prev.get("title", "")).strip().lower()
            prev_dev_name = prev_title[:-8].strip() if prev_title.endswith(" offline") else ""
            prev_site = str(prev.get("site", "")).strip().lower()
            is_confirmed_online = (
                pid in online_device_keys
                or pid.lower() in online_device_keys
                or (
                    bool(prev_dev_name)
                    and (
                        (prev_dev_name, prev_site) in online_device_names
                        or (prev_dev_name, "") in online_device_names
                    )
                )
            )
            if partial_devices and pid.startswith("device:") and not is_confirmed_online:
                cur_dev = dict(prev)
                cur_dev["durationSeconds"] = max(1, now - int(cur_dev.get("startedAt", now)))
                result_active.append(cur_dev)
                continue
            resolved_copy = dict(prev)
            resolved_copy["active"] = False
            started_at = int(prev.get("startedAt", now))
            resolved_copy["resolvedAt"] = now
            resolved_copy["durationSeconds"] = max(1, now - started_at)
            result_resolved.append(resolved_copy)
        elif not was_active:
            result_resolved.append(prev)

    seen_resolved: set[tuple[str, int, int]] = set()
    deduped_resolved: list[dict[str, Any]] = []
    for item in result_resolved:
        sig = (str(item.get("id")), int(item.get("startedAt", 0)), int(item.get("resolvedAt", 0)))
        if sig not in seen_resolved:
            seen_resolved.add(sig)
            deduped_resolved.append(item)
    result_resolved = deduped_resolved

    result_resolved.sort(key=lambda x: int(x.get("resolvedAt", 0)), reverse=True)
    result_resolved = result_resolved[:MAX_HISTORY_ISSUES]

    try:
        private_dir(CONFIG_DIR)
        to_save = result_active + result_resolved
        ISSUES_FILE.write_text(json.dumps(to_save, separators=(",", ":")), encoding="utf-8")
    except Exception:
        pass

    return result_active + result_resolved


