def site_sort_key(site: dict[str, Any]) -> tuple[int, str]:
    priority = {"down": 0, "backup": 1, "up": 2}
    return priority.get(str(site.get("status", "up")), 3), str(site.get("name", "")).casefold()


def build_capabilities(
    config: dict[str, Any] | None = None,
    key: str | None = None,
    sites: list[dict[str, Any]] | None = None,
    failed_endpoints: list[str] | None = None,
    endpoint_errors: dict[str, str] | None = None,
) -> dict[str, Any]:
    cfg = config or read_config() or {}
    missing_scopes = set(cfg.get("missingScopes", cfg.get("missing_scopes", [])))
    cfg_caps = cfg.get("capabilities", {})
    if not isinstance(cfg_caps, dict):
        cfg_caps = {}

    all_viewer = bool(sites and all(s.get("permission") == "viewer" for s in sites))
    errors_str = " ".join(endpoint_errors.values() if endpoint_errors else []).lower()
    endpoints_str = " ".join(failed_endpoints if failed_endpoints else []).lower()

    # powerCycle: requires devices:write
    if cfg_caps.get("powerCycle") is not None:
        power_allowed = bool(cfg_caps.get("powerCycle"))
    elif "devices:write" in missing_scopes or "power_cycle" in missing_scopes:
        power_allowed = False
    elif all_viewer:
        power_allowed = False
    elif any(("cmd/devmgr" in ep or "power-cycle" in ep) for ep in (failed_endpoints or [])) and ("401" in errors_str or "403" in errors_str):
        power_allowed = False
    else:
        power_allowed = True

    # firmwareUpgrade: requires firmware:upgrade
    if cfg_caps.get("firmwareUpgrade") is not None:
        firmware_allowed = bool(cfg_caps.get("firmwareUpgrade"))
    elif "firmware:upgrade" in missing_scopes or "upgrade" in missing_scopes:
        firmware_allowed = False
    elif all_viewer:
        firmware_allowed = False
    elif any(("upgrade" in ep or "cmd/devmgr" in ep) for ep in (failed_endpoints or [])) and ("401" in errors_str or "403" in errors_str):
        firmware_allowed = False
    else:
        firmware_allowed = True

    # protectStreams: requires protect:stream / protect.read
    if cfg_caps.get("protectStreams") is not None:
        protect_allowed = bool(cfg_caps.get("protectStreams"))
    elif "protect:stream" in missing_scopes or "protect.read" in missing_scopes or "protect" in missing_scopes:
        protect_allowed = False
    elif any("protect" in ep for ep in (failed_endpoints or [])) and ("401" in errors_str or "403" in errors_str):
        protect_allowed = False
    else:
        protect_allowed = True

    return {
        "powerCycle": {
            "supported": True,
            "allowed": power_allowed,
            "requiredScope": "devices:write",
            "missingPermission": "Missing 'devices:write' scope (Network Admin or Owner role required for PoE power cycling)",
            "warning": "API key lacks 'devices:write' scope: PoE power cycling disabled for this API key.",
        },
        "firmwareUpgrade": {
            "supported": True,
            "allowed": firmware_allowed,
            "requiredScope": "firmware:upgrade",
            "missingPermission": "Missing 'firmware:upgrade' scope (Admin role required for firmware updates)",
            "warning": "API key lacks 'firmware:upgrade' scope: Firmware upgrades are restricted for this API key.",
        },
        "protectStreams": {
            "supported": True,
            "allowed": protect_allowed,
            "requiredScope": "protect:stream",
            "missingPermission": "Missing 'protect.read' or 'protect:stream' scope (Protect access required for camera snapshots & streams)",
            "warning": "API key lacks 'protect:stream' scope: Camera snapshots and live streams are unavailable.",
        },
    }


def _interpolate_288(pts: list[float], final_val: float | None = None) -> list[float]:
    res: list[float] = []
    n = len(pts)
    for k in range(288):
        x = (k / 287.0) * (n - 1)
        i0 = int(x)
        i1 = min(n - 1, i0 + 1)
        t = x - i0
        mu = (1.0 - math.cos(t * math.pi)) / 2.0
        val = pts[i0] * (1.0 - mu) + pts[i1] * mu
        res.append(round(val, 1))
    if final_val is not None:
        res[-1] = final_val
    return res


