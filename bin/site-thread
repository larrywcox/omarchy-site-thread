def load_device_names() -> dict[str, str]:
    config = read_config() or {}
    is_demo = bool(config.get("demo")) or config.get("mode") == "demo"
    names = dict(DEFAULT_DEVICE_NAMES) if is_demo else {}
    try:
        if DEVICE_NAMES_FILE.exists():
            data = json.loads(DEVICE_NAMES_FILE.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                for k, v in data.items():
                    if isinstance(k, str) and isinstance(v, str) and v.strip():
                        if v.strip().lower() == "core switch":
                            continue
                        names[k.lower()] = v.strip()
    except Exception:
        pass
    return names


def save_device_names(mapping: dict[str, str]) -> None:
    if not mapping:
        return
    try:
        current = load_device_names()
        updated = False
        for k, v in mapping.items():
            if not k or not v:
                continue
            k_clean = str(k).strip().lower()
            v_clean = str(v).strip()
            if v_clean.lower() == "core switch":
                continue
            if MAC_PATTERN.fullmatch(v_clean) or IP_PATTERN.fullmatch(v_clean):
                continue
            if v_clean and current.get(k_clean) != v_clean:
                current[k_clean] = v_clean
                updated = True
        if updated:
            private_dir(CACHE_DIR)
            DEVICE_NAMES_FILE.write_text(json.dumps(current, indent=2), encoding="utf-8")
    except Exception:
        pass


def resolve_device_name(mac_or_id: str) -> str:
    if not mac_or_id:
        return ""
    clean = str(mac_or_id).strip()
    names = load_device_names()
    if clean.lower() in names:
        return names[clean.lower()]
    return clean


def format_operation_entry(item: dict[str, Any], names: dict[str, str] | None = None) -> dict[str, Any]:
    if names is None:
        names = load_device_names()
    config = read_config() or {}
    is_demo = bool(config.get("demo")) or config.get("mode") == "demo"
    fallback_switch = "USW Pro 24 PoE" if is_demo else "Switch"

    copy_item = dict(item)
    raw_target = str(copy_item.get("target") or "")
    dev_name = str(copy_item.get("deviceName") or copy_item.get("device_name") or copy_item.get("name") or "")
    if dev_name.strip().lower() == "core switch":
        dev_name = fallback_switch

    # Preserve MAC in metadata if present or if target had a MAC
    if "mac" not in copy_item:
        if MAC_PATTERN.fullmatch(raw_target.strip()):
            copy_item["mac"] = raw_target.strip().lower()
        else:
            m_match = re.search(r"\b([0-9a-fA-F]{2}(?::[0-9a-fA-F]{2}){5})\b", raw_target)
            if m_match:
                copy_item["mac"] = m_match.group(1).lower()

    def _replace_mac(text: str) -> str:
        if not text:
            return ""
        def _sub_port(match: re.Match) -> str:
            port_num = match.group(1)
            mac_str = match.group(2).lower()
            hname = names.get(mac_str) or dev_name or mac_str
            if hname.strip().lower() == "core switch":
                hname = fallback_switch
            return f"Port {port_num} on {hname}"
        text = re.sub(r"Port\s+(\d+)\s*\(([0-9a-fA-F:]{17})\)", _sub_port, text, flags=re.IGNORECASE)

        def _sub_mac(match: re.Match) -> str:
            m = match.group(0).lower()
            res = names.get(m) or dev_name or m
            if res.strip().lower() == "core switch":
                res = fallback_switch
            return res
        text = re.sub(r"\b(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}\b", _sub_mac, text)
        return re.sub(r"(?i)\bcore\s+switch\b", fallback_switch, text)

    if MAC_PATTERN.fullmatch(raw_target.strip()):
        clean_mac = raw_target.strip().lower()
        resolved = names.get(clean_mac) or dev_name or clean_mac
        if resolved.strip().lower() == "core switch":
            resolved = fallback_switch
        copy_item["target"] = resolved
    else:
        copy_item["target"] = _replace_mac(raw_target)

    raw_title = str(copy_item.get("title") or "")
    if raw_title:
        copy_item["title"] = _replace_mac(raw_title)
    elif copy_item.get("target"):
        op_t = str(copy_item.get("type", "operation")).replace("_", " ").title()
        copy_item["title"] = f"{op_t}: {copy_item['target']}"

    raw_msg = str(copy_item.get("message") or "")
    if raw_msg:
        copy_item["message"] = _replace_mac(raw_msg)

    return copy_item


def record_operation(
    op_type: str,
    target: str,
    status: str,
    message: str,
    *,
    title: str = "",
    error: str = "",
    mac: str = "",
    host_id: str = "",
    device_name: str = "",
    permission_error: bool = False,
    required_scope: str = "",
    **extra: Any,
) -> dict[str, Any]:
    now = int(time.time())
    dt = datetime.datetime.fromtimestamp(now, tz=datetime.timezone.utc)
    entry = {
        "id": f"op_{now}_{abs(hash(target + op_type)) % 100000}",
        "type": op_type,
        "title": title or f"{op_type.replace('_', ' ').title()}: {target}",
        "target": target,
        "status": status,  # "accepted", "in_progress", "completed", "failed"
        "message": message,
        "error": error,
        "mac": mac.lower() if mac else "",
        "hostId": host_id,
        "deviceName": device_name,
        "permissionError": permission_error,
        "requiredScope": required_scope,
        "timestamp": now,
        "timeText": dt.strftime("%b %d, %H:%M UTC"),
        "relativeTime": "Just now",
    }
    entry.update(extra)
    try:
        private_dir(CACHE_DIR)
        history: list[dict[str, Any]] = []
        if OPERATIONS_HISTORY_FILE.exists():
            try:
                loaded = json.loads(OPERATIONS_HISTORY_FILE.read_text(encoding="utf-8"))
                if isinstance(loaded, list):
                    history = loaded
            except Exception:
                history = []
        history.insert(0, entry)
        history = history[:MAX_OPERATIONS_HISTORY]
        OPERATIONS_HISTORY_FILE.write_text(json.dumps(history, indent=2), encoding="utf-8")
    except Exception:
        pass
    return entry


