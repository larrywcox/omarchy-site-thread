#!/usr/bin/env python3
"""Secure local helper for the Omarchy UniFi SiteThread bar plugin.

The API key is accepted only over stdin and stored in the desktop Secret
Service. Console identity is pinned before the key is transmitted.
"""

from __future__ import annotations

import argparse
import base64
from concurrent.futures import ThreadPoolExecutor
import datetime
import hashlib
import json
import math
import os
from pathlib import Path
import re
import selectors
import signal
import ssl
import subprocess
import sys
import time
from typing import Any
from urllib.parse import quote, urlencode, urlparse


APP = "site-thread"
LEGACY_APP = "unifi-fabric"
PROFILE = "default"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / APP
CONFIG_FILE = CONFIG_DIR / "connection.json"
ISSUES_FILE = CONFIG_DIR / "issues.json"
MAX_HISTORY_ISSUES = 30
LEGACY_CONFIG_FILE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / LEGACY_APP / "connection.json"
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/{APP}-{os.getuid()}")) / APP
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / APP
SITE_CACHE_DIR = CACHE_DIR / "sites"
RECENT_OPS_FILE = CACHE_DIR / "recent_operations.json"
OPERATIONS_HISTORY_FILE = CACHE_DIR / "operations_history.json"
DEVICE_NAMES_FILE = CACHE_DIR / "device_names.json"
MAX_OPERATIONS_HISTORY = 50
SITE_CACHE_TTL = 600
TELEMETRY_CACHE_DIR = CACHE_DIR / "telemetry"
TELEMETRY_5M_TTL = 300
TELEMETRY_WLAN_TTL = 180
KEY_PATTERN = re.compile(r"^[A-Za-z0-9._~+/=-]{8,4096}$")
ID_PATTERN = re.compile(r"^[A-Za-z0-9_-]{1,128}$")
HOST_ID_PATTERN = re.compile(r"^[A-Za-z0-9:_-]{1,256}$")
MAC_PATTERN = re.compile(r"^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$")
IP_PATTERN = re.compile(r"^\d{1,3}(\.\d{1,3}){3}$")
MAX_STDOUT_BYTES = 1024 * 1024
MAX_STDERR_BYTES = 64 * 1024
MAX_SNAPSHOT_BYTES = 16 * 1024 * 1024
MAX_JSON_DEPTH = 20
MAX_JSON_COLLECTION_ITEMS = 1000
MAX_JSON_TOTAL_VALUES = 20_000
MAX_JSON_STRING_CHARS = 4096
MAX_JSON_KEY_CHARS = 256
MAX_JSON_NUMBER_ABS = 10**15
MAX_ROWS_PER_RESPONSE = 500
MAX_PAGINATED_ROWS = 4000
MAX_MODEL_ITEMS = 500


class FabricError(RuntimeError):
    pass


def emit(payload: dict[str, Any], exit_code: int = 0) -> None:
    validate_json_limits(payload)
    print(json.dumps(payload, separators=(",", ":")))
    raise SystemExit(exit_code)


def fail(message: str, *, connected: bool | None = None, details: dict[str, Any] | None = None, **extra: Any) -> None:
    payload: dict[str, Any] = {"ok": False, "error": message}
    if connected is not None:
        payload["connected"] = connected
    if details:
        payload["details"] = details
    payload.update(extra)
    emit(payload, 1)


def private_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    if path.is_symlink() or not path.is_dir() or path.stat().st_uid != os.getuid():
        raise FabricError(f"Unsafe private directory: {path}")
    path.chmod(0o700)


def normalize_host(raw: str) -> tuple[str, str, int]:
    value = raw.strip()
    if not value:
        raise FabricError("Enter the address of your UniFi console")
    if "://" not in value:
        value = "https://" + value
    parsed = urlparse(value)
    if parsed.scheme != "https" or not parsed.hostname:
        raise FabricError("Use an HTTPS console address")
    if len(parsed.hostname) > 253:
        raise FabricError("The console hostname is too long")
    if parsed.username or parsed.password or parsed.query or parsed.fragment:
        raise FabricError("The console address must not contain credentials or query data")
    if parsed.path not in ("", "/"):
        raise FabricError("Use the console address without an application path")
    port = parsed.port or 443
    display = parsed.hostname if port == 443 else f"{parsed.hostname}:{port}"
    return "https://" + display, parsed.hostname, port


def terminate_process_group(process: subprocess.Popen[bytes]) -> None:
    """Stop and reap a child and every process it started."""
    try:
        # Kill the group even if its leader has exited; descendants may still
        # hold a capture pipe open or continue producing data.
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    process.wait()


def run_bytes(
    command: list[str],
    *,
    input_data: bytes | None = None,
    timeout: int = 15,
    stdout_limit: int = MAX_STDOUT_BYTES,
    stderr_limit: int = MAX_STDERR_BYTES,
) -> subprocess.CompletedProcess[bytes]:
    """Run a child while bounding both captured streams as they are produced."""
    try:
        process = subprocess.Popen(
            command,
            stdin=subprocess.PIPE if input_data is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
    except OSError as exc:
        raise FabricError(str(exc)) from exc

    assert process.stdout is not None and process.stderr is not None
    if process.stdin is not None:
        try:
            process.stdin.write(input_data or b"")
            process.stdin.close()
        except (BrokenPipeError, OSError):
            pass

    streams: dict[Any, tuple[str, int, bytearray]] = {
        process.stdout: ("stdout", stdout_limit, bytearray()),
        process.stderr: ("stderr", stderr_limit, bytearray()),
    }
    selector = selectors.DefaultSelector()
    for stream in streams:
        os.set_blocking(stream.fileno(), False)
        selector.register(stream, selectors.EVENT_READ)

    deadline = time.monotonic() + timeout
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise FabricError(f"Command timed out after {timeout} seconds")
            for key, _ in selector.select(remaining):
                stream = key.fileobj
                name, limit, captured = streams[stream]
                chunk = os.read(stream.fileno(), min(65_536, limit - len(captured) + 1))
                if not chunk:
                    selector.unregister(stream)
                    stream.close()
                    continue
                captured.extend(chunk)
                if len(captured) > limit:
                    raise FabricError(f"Command {name} exceeded the {limit}-byte safety limit")
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise FabricError(f"Command timed out after {timeout} seconds")
        returncode = process.wait(timeout=remaining)
    except FabricError:
        terminate_process_group(process)
        raise
    except subprocess.TimeoutExpired as exc:
        terminate_process_group(process)
        raise FabricError(f"Command timed out after {timeout} seconds") from exc
    except OSError as exc:
        terminate_process_group(process)
        raise FabricError(f"Could not capture command output: {exc}") from exc
    finally:
        selector.close()
        for stream in streams:
            if not stream.closed:
                stream.close()

    return subprocess.CompletedProcess(
        command,
        returncode,
        stdout=bytes(streams[process.stdout][2]),
        stderr=bytes(streams[process.stderr][2]),
    )


def run(
    command: list[str],
    *,
    input_text: str | None = None,
    timeout: int = 15,
    stdout_limit: int = MAX_STDOUT_BYTES,
    stderr_limit: int = MAX_STDERR_BYTES,
) -> subprocess.CompletedProcess[str]:
    try:
        result = run_bytes(
            command,
            input_data=input_text.encode() if input_text is not None else None,
            timeout=timeout,
            stdout_limit=stdout_limit,
            stderr_limit=stderr_limit,
        )
        return subprocess.CompletedProcess(
            result.args,
            result.returncode,
            stdout=result.stdout.decode("utf-8", errors="replace"),
            stderr=result.stderr.decode("utf-8", errors="replace"),
        )
    except OSError as exc:
        raise FabricError(str(exc)) from exc


def validate_json_limits(payload: Any) -> None:
    """Reject decoded responses whose shape is too costly to retain or traverse."""
    pending: list[tuple[Any, int]] = [(payload, 0)]
    seen = 0
    while pending:
        value, depth = pending.pop()
        seen += 1
        if seen > MAX_JSON_TOTAL_VALUES:
            raise FabricError("The server returned too many JSON values")
        if depth > MAX_JSON_DEPTH:
            raise FabricError("The server returned JSON nested too deeply")
        if isinstance(value, str):
            if len(value) > MAX_JSON_STRING_CHARS:
                raise FabricError("The server returned an oversized JSON string")
        elif isinstance(value, (int, float)) and not isinstance(value, bool):
            if not math.isfinite(value) or abs(value) > MAX_JSON_NUMBER_ABS:
                raise FabricError("The server returned an out-of-range JSON number")
        elif isinstance(value, list):
            if len(value) > MAX_JSON_COLLECTION_ITEMS:
                raise FabricError("The server returned an oversized JSON array")
            pending.extend((child, depth + 1) for child in value)
        elif isinstance(value, dict):
            if len(value) > MAX_JSON_COLLECTION_ITEMS:
                raise FabricError("The server returned an oversized JSON object")
            for key, child in value.items():
                if not isinstance(key, str) or len(key) > MAX_JSON_KEY_CHARS:
                    raise FabricError("The server returned an invalid JSON field name")
                pending.append((child, depth + 1))


def decode_json(body: str) -> Any:
    if not body:
        return None
    try:
        payload = json.loads(body)
    except json.JSONDecodeError:
        return None
    except (RecursionError, ValueError) as exc:
        raise FabricError("The server returned overly complex JSON") from exc
    validate_json_limits(payload)
    return payload


def fetch_certificate(hostname: str, port: int) -> str:
    result = run(
        [
            "openssl",
            "s_client",
            "-connect",
            f"{hostname}:{port}",
            "-servername",
            hostname,
            "-showcerts",
        ],
        input_text="",
        timeout=10,
    )
    match = re.search(r"-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----", result.stdout, re.S)
    if not match:
        raise FabricError("Could not read the console certificate")
    return match.group(0) + "\n"


def certificate_identity(pem: str) -> tuple[str, str]:
    der = ssl.PEM_cert_to_DER_cert(pem)
    fingerprint = hashlib.sha256(der).hexdigest().upper()
    pretty = ":".join(fingerprint[index:index + 2] for index in range(0, len(fingerprint), 2))

    pubkey = run_bytes(
        ["openssl", "x509", "-pubkey", "-noout"], input_data=pem.encode(), timeout=10,
        stdout_limit=64 * 1024,
    )
    encoded = run_bytes(
        ["openssl", "pkey", "-pubin", "-outform", "DER"], input_data=pubkey.stdout, timeout=10,
        stdout_limit=64 * 1024,
    )
    if pubkey.returncode != 0 or encoded.returncode != 0 or not encoded.stdout:
        raise FabricError("Could not pin the console public key")
    spki = base64.b64encode(hashlib.sha256(encoded.stdout).digest()).decode("ascii")
    return pretty, spki


def read_config() -> dict[str, Any] | None:
    for path in (CONFIG_FILE, LEGACY_CONFIG_FILE):
        try:
            if path.stat().st_size > 64 * 1024:
                continue
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        try:
            validate_json_limits(data)
        except FabricError:
            continue
        if data.get("mode") == "cloud" and data.get("baseUrl") == "https://api.ui.com":
            return data
        required = ("baseUrl", "hostname", "port", "fingerprint", "spki")
        if all(data.get(key) not in (None, "") for key in required):
            return data
    return None


def write_config(data: dict[str, Any]) -> None:
    private_dir(CONFIG_DIR)
    temp = CONFIG_DIR / ".connection.json.tmp"
    temp.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    temp.chmod(0o600)
    temp.replace(CONFIG_FILE)
    CONFIG_FILE.chmod(0o600)


def secret_lookup() -> str:
    for application in (APP, LEGACY_APP):
        result = run(["secret-tool", "lookup", "application", application, "profile", PROFILE], timeout=8)
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    return ""


def secret_store(key: str) -> None:
    result = run(
        ["secret-tool", "store", "--label=UniFi SiteThread API key", "application", APP, "profile", PROFILE],
        input_text=key,
        timeout=30,
    )
    if result.returncode != 0:
        raise FabricError("The desktop credential store rejected the API key")


def secret_clear() -> None:
    for application in (APP, LEGACY_APP):
        run(["secret-tool", "clear", "application", application, "profile", PROFILE], timeout=10)


def api_request(config: dict[str, Any], key: str, path: str, *, output: Path | None = None, method: str = "GET", payload: Any = None) -> tuple[int, str]:
    if not KEY_PATTERN.fullmatch(key):
        raise FabricError("The stored API key is malformed")
    url = config["baseUrl"] + path
    args = [
        "curl", "-sS", "-k", "--pinnedpubkey", f"sha256//{config['spki']}",
        "--config", "-", "--max-time", "12", "-w", "\n%{http_code}",
    ]
    if output is not None:
        args.extend(["--max-filesize", str(MAX_SNAPSHOT_BYTES), "-o", str(output)])
    input_text = f'header = "X-API-KEY: {key}"\n'
    if payload is not None or method.upper() == "POST":
        args.extend(["-X", method.upper(), "--data-raw", json.dumps(payload)])
        input_text += 'header = "Content-Type: application/json"\n'
    args.append(url)
    result = run(args, input_text=input_text, timeout=18)
    if result.returncode != 0:
        if output is not None:
            output.unlink(missing_ok=True)
        raise FabricError("The UniFi console could not be reached securely")
    lines = result.stdout.rstrip("\n").split("\n")
    try:
        status = int(lines[-1])
    except (IndexError, ValueError) as exc:
        raise FabricError("The console returned an invalid response") from exc
    return status, "\n".join(lines[:-1])


def json_request(config: dict[str, Any], key: str, path: str) -> tuple[int, Any]:
    status, body = api_request(config, key, path)
    return status, decode_json(body)


def cloud_json_request(key: str, path: str, method: str = "GET", payload: Any = None) -> tuple[int, Any]:
    if not KEY_PATTERN.fullmatch(key):
        raise FabricError("The stored API key is malformed")
    cmd = [
        "curl", "-sS", "--fail-with-body", "--max-time", "15",
        "--config", "-", "-w", "\n%{http_code}", "https://api.ui.com" + path,
    ]
    input_text = f'header = "Accept: application/json"\nheader = "X-API-KEY: {key}"\n'
    if payload is not None or method.upper() == "POST":
        cmd.extend(["-X", method.upper(), "--data-raw", json.dumps(payload)])
        input_text += 'header = "Content-Type: application/json"\n'
    result = run(
        cmd,
        input_text=input_text,
        timeout=20,
    )
    lines = result.stdout.rstrip("\n").split("\n")
    try:
        status = int(lines[-1])
    except (IndexError, ValueError) as exc:
        raise FabricError("UniFi Site Manager returned an invalid response") from exc
    body = "\n".join(lines[:-1])
    return status, decode_json(body)


def connector_path(host_id: str, path: str) -> str:
    if not HOST_ID_PATTERN.fullmatch(host_id):
        raise FabricError("Invalid UniFi console id")
    return f"/v1/connector/consoles/{quote(host_id, safe='')}/proxy/{path.lstrip('/')}"


def cloud_file_request(key: str, path: str, output: Path) -> int:
    if not KEY_PATTERN.fullmatch(key):
        raise FabricError("The stored API key is malformed")
    result = run(
        [
            "curl", "-sS", "--max-time", "15", "--config", "-",
            "--max-filesize", str(MAX_SNAPSHOT_BYTES), "-o", str(output),
            "-w", "%{http_code}", "https://api.ui.com" + path,
        ],
        input_text=f'header = "X-API-KEY: {key}"\n',
        timeout=20,
    )
    if result.returncode != 0:
        output.unlink(missing_ok=True)
        raise FabricError("UniFi Cloud Connector returned an oversized or invalid response")
    try:
        return int(result.stdout.strip())
    except ValueError as exc:
        raise FabricError("UniFi Cloud Connector returned an invalid response") from exc


def cloud_rows(key: str, endpoint: str) -> list[dict[str, Any]]:
    output: list[dict[str, Any]] = []
    token = ""
    for _ in range(20):
        query = {"pageSize": "200"}
        if token:
            query["nextToken"] = token
        status, payload = cloud_json_request(key, endpoint + "?" + urlencode(query))
        if status != 200:
            raw_message = payload.get("message") if isinstance(payload, dict) else ""
            message = model_string(raw_message) if isinstance(raw_message, str) else ""
            raise FabricError(message or f"UniFi Site Manager returned HTTP {status}")
        page = rows(payload)
        if len(output) + len(page) > MAX_PAGINATED_ROWS:
            raise FabricError("UniFi Site Manager returned too many rows")
        output.extend(page)
        token = model_string(payload.get("nextToken", ""), max_length=2048) if isinstance(payload, dict) else ""
        if not token:
            return output
    raise FabricError("UniFi Site Manager pagination did not finish")


def rows(payload: Any) -> list[dict[str, Any]]:
    source: Any = None
    if isinstance(payload, list):
        source = payload
    elif isinstance(payload, dict):
        for key in ("data", "items", "results"):
            if isinstance(payload.get(key), list):
                source = payload[key]
                break
    if source is None:
        return []
    if len(source) > MAX_ROWS_PER_RESPONSE:
        raise FabricError("The server returned too many rows")
    return [item for item in source if isinstance(item, dict)]


def model_string(value: Any, default: str = "", max_length: int = 256) -> str:
    if value in (None, ""):
        value = default
    rendered = str(value)
    if len(rendered) > max_length:
        raise FabricError("The server returned an oversized model field")
    return rendered


def first_value(item: dict[str, Any], *keys: str, default: Any = "") -> Any:
    for key in keys:
        value = item.get(key)
        if value not in (None, ""):
            return value
    return default


def is_online(item: dict[str, Any]) -> bool:
    raw = first_value(item, "state", "status", "connectionState", default="CONNECTED")
    if isinstance(raw, bool):
        return raw
    return str(raw).upper() in {"CONNECTED", "ONLINE", "ACTIVE", "ADOPTED", "UP", "1", "TRUE"}


def compact_device(item: dict[str, Any]) -> dict[str, Any]:
    uplink_obj = item.get("uplink") if isinstance(item.get("uplink"), dict) else {}
    fw_status = str(item.get("firmwareStatus") or "").lower()
    has_update = bool(
        fw_status in ("updateavailable", "updatable", "upgradable")
        or item.get("updateAvailable")
        or item.get("firmwareUpgradable")
        or item.get("upgradable")
        or item.get("upgradeable")
        or item.get("has_upgrade")
        or str(item.get("state") or "").upper() in ("UPGRADABLE", "4")
    )
    return {
        "id": model_string(first_value(item, "id", "_id", "mac"), max_length=256),
        "name": model_string(first_value(item, "name", "displayName", "model", "shortname", default="UniFi device")),
        "model": model_string(first_value(item, "model", "shortname", "type")),
        "ip": model_string(first_value(item, "ipAddress", "ip", "lanIp"), max_length=64),
        "online": is_online(item),
        "update": has_update,
        "parentName": model_string(first_value(item, "parentName", default=uplink_obj.get("uplink_device_name", ""))),
        "parentMac": model_string(first_value(item, "parentMac", default=uplink_obj.get("uplink_mac", ""))),
        "parentPort": int(first_value(item, "parentPort", default=uplink_obj.get("uplink_remote_port") or uplink_obj.get("port_idx") or 0)),
        "uplinkSpeed": int(first_value(item, "uplinkSpeed", default=uplink_obj.get("speed") or 0)),
        "uplinkMedia": model_string(first_value(item, "uplinkMedia", default=uplink_obj.get("media", ""))),
    }


def nested_number(item: dict[str, Any], *path: str) -> float:
    value: Any = item
    for key in path:
        if not isinstance(value, dict):
            return 0
        value = value.get(key)
    try:
        return float(value or 0)
    except (TypeError, ValueError):
        return 0


def compact_camera(item: dict[str, Any]) -> dict[str, Any]:
    return {
        "id": model_string(first_value(item, "id", "_id"), max_length=256),
        "name": model_string(first_value(item, "name", "displayName", default="Camera")),
        "model": model_string(first_value(item, "type", "modelKey", "model")),
        "online": is_online(item),
        "recording": bool(first_value(item, "isRecording", "recording", default=True)),
    }


def telemetry_flag(value: Any, *names: str) -> bool:
    wanted = {name.lower() for name in names}
    if isinstance(value, dict):
        for key, child in value.items():
            if key.lower() in wanted and child is True:
                return True
            if telemetry_flag(child, *names):
                return True
    elif isinstance(value, list):
        return any(telemetry_flag(child, *names) for child in value)
    return False


def latest_issue_period(value: Any) -> Any:
    if isinstance(value, dict) and isinstance(value.get("periods"), list):
        value = value["periods"]
    if not isinstance(value, list):
        return value
    candidates = [item for item in value if isinstance(item, dict)]
    if not candidates:
        return []
    return max(candidates, key=lambda item: nested_number(item, "index"))


def host_is_online(host: dict[str, Any]) -> bool:
    reported = host.get("reportedState") if isinstance(host.get("reportedState"), dict) else {}
    state = first_value(reported, "state", "connectionState", default="connected")
    return str(state).lower() in {"connected", "online", "active", "up"}


def site_health(stats: dict[str, Any], counts: dict[str, Any]) -> tuple[str, str]:
    """Return a conservative current site state from Site Manager telemetry."""
    offline_gateways = int(nested_number(counts, "offlineGatewayDevice"))
    total_gateways = int(nested_number(counts, "gatewayDevice"))
    total_devices = int(nested_number(counts, "totalDevice"))
    offline_devices = int(nested_number(counts, "offlineDevice"))
    issues = latest_issue_period(stats.get("internetIssues", []))
    issue_text = json.dumps(issues, separators=(",", ":")).lower()
    backup_active = telemetry_flag(
        issues, "wan2FailoverActive", "wan2_failover_active", "backupWanActive", "backup_wan_active", "failoverActive"
    )
    if (
        offline_gateways > 0
        or (total_gateways > 0 and offline_gateways >= total_gateways)
        or (total_devices > 0 and offline_devices >= total_devices)
        or any(word in issue_text for word in ("unreachable", "internet down", "wan down", "disconnected"))
    ):
        return "down", "Site unreachable"
    if backup_active:
        return "backup", "Backup WAN active"
    if telemetry_flag(issues, "wanDowntime", "wan_downtime"):
        return "down", "Site unreachable"
    return "up", "Online"


