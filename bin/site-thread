def get_operations_history(limit: int = 20) -> list[dict[str, Any]]:
    names = load_device_names()
    config = read_config() or {}
    is_demo = bool(config.get("demo")) or config.get("mode") == "demo"
    try:
        if OPERATIONS_HISTORY_FILE.exists():
            data = json.loads(OPERATIONS_HISTORY_FILE.read_text(encoding="utf-8"))
            if isinstance(data, list):
                if not data:
                    return []
                now = int(time.time())
                formatted_list: list[dict[str, Any]] = []
                for item in data:
                    if not isinstance(item, dict):
                        continue
                    if not is_demo:
                        item_mac = str(item.get("mac", "")).lower()
                        item_host = str(item.get("hostId", "")).lower()
                        item_target = str(item.get("target", "")).lower()
                        item_title = str(item.get("title", "")).lower()
                        if item_mac == "00:11:22:33:44:55" or "00:11:22:33:44:55" in item_target:
                            continue
                        if item_host in ("host_hq", "host-1", "console-1", "console-home", "console-office", "console-warehouse"):
                            continue
                        if "core switch" in item_target or "core switch" in item_title:
                            continue
                    ts = item.get("timestamp", 0)
                    diff = max(0, now - ts)
                    if diff < 60:
                        item["relativeTime"] = "Just now"
                    elif diff < 3600:
                        item["relativeTime"] = f"{diff // 60}m ago"
                    elif diff < 86400:
                        item["relativeTime"] = f"{diff // 3600}h ago"
                    else:
                        item["relativeTime"] = f"{diff // 86400}d ago"
                    formatted_list.append(format_operation_entry(item, names))
                return formatted_list[:limit]
    except Exception:
        pass
    if is_demo:
        return [format_operation_entry(op, names) for op in get_default_operations()[:limit]]
    return []


def reconcile_operations(
    backups: list[dict[str, Any]] | None = None,
    updates: list[dict[str, Any]] | None = None,
) -> None:
    try:
        if not OPERATIONS_HISTORY_FILE.exists():
            return
        history = json.loads(OPERATIONS_HISTORY_FILE.read_text(encoding="utf-8"))
        if not isinstance(history, list) or not history:
            return
        now = int(time.time())
        changed = False
        names = load_device_names()

        backup_map: dict[str, int] = {}
        if backups:
            for b in backups:
                hid = str(b.get("hostId", ""))
                ts = int(b.get("timestamp", 0))
                if hid and ts:
                    backup_map[hid] = ts

        updating_macs: set[str] = set()
        if updates:
            for u in updates:
                mac = str(u.get("mac", "")).lower()
                if mac:
                    updating_macs.add(mac)

        for item in history:
            op_status = item.get("status")
            op_type = item.get("type")
            target = str(item.get("target", ""))
            op_ts = int(item.get("timestamp", 0))

            if op_status in ("accepted", "in_progress"):
                if op_type == "backup":
                    host_id = str(item.get("hostId") or item.get("host_id") or target)
                    host_ts = backup_map.get(host_id, 0)
                    if not host_ts and target in backup_map:
                        host_ts = backup_map[target]
                    if host_ts >= op_ts or (now - op_ts > 120):
                        item["status"] = "completed"
                        disp_name = item.get("deviceName") or item.get("device_name") or target
                        item["message"] = f"Cloud configuration backup archived successfully for {disp_name}."
                        changed = True
                elif op_type == "upgrade":
                    if updates is not None:
                        op_mac = str(item.get("mac") or (target if MAC_PATTERN.fullmatch(target) else "")).lower()
                        if op_mac:
                            if op_mac not in updating_macs and (now - op_ts > 30):
                                item["status"] = "completed"
                                disp_name = item.get("deviceName") or item.get("device_name") or target
                                if MAC_PATTERN.fullmatch(disp_name.strip()):
                                    disp_name = names.get(disp_name.strip().lower(), disp_name)
                                item["message"] = f"Firmware upgrade completed for {disp_name}. Device active on target firmware."
                                changed = True
                        elif now - op_ts > 30:
                            item["status"] = "completed"
                            disp_name = item.get("deviceName") or item.get("device_name") or target
                            if MAC_PATTERN.fullmatch(disp_name.strip()):
                                disp_name = names.get(disp_name.strip().lower(), disp_name)
                            item["message"] = f"Firmware upgrade completed for {disp_name}. Device active on target firmware."
                            changed = True
                elif op_type == "upgrade_batch":
                    if updates is not None and len(updates) == 0 and (now - op_ts > 30):
                        item["status"] = "completed"
                        item["message"] = "Fleet batch upgrade completed for all devices."
                        changed = True
                elif op_type == "power_cycle":
                    if now - op_ts > 45:
                        item["status"] = "completed"
                        disp_target = format_operation_entry(item, names)["target"]
                        item["message"] = f"PoE power cycle completed for {disp_target}. Power and link restored."
                        changed = True

        if changed:
            OPERATIONS_HISTORY_FILE.write_text(json.dumps(history, indent=2), encoding="utf-8")
    except Exception:
        pass


def get_recent_operations() -> tuple[dict[str, int], dict[str, int]]:
    try:
        if RECENT_OPS_FILE.exists():
            data = json.loads(RECENT_OPS_FILE.read_text(encoding="utf-8")) or {}
            now = int(time.time())
            raw_backups = data.get("backups", {})
            raw_upgrades = data.get("upgrades", {})
            backups = {k: int(v) for k, v in raw_backups.items() if isinstance(v, (int, float)) and now - v < 600}
            upgrades = {k: int(v) for k, v in raw_upgrades.items() if isinstance(v, (int, float)) and now - v < 600}
            return backups, upgrades
    except Exception:
        pass
    return {}, {}


