def record_backup_request(host_id: str) -> None:
    try:
        private_dir(CACHE_DIR)
        data: dict[str, Any] = {}
        if RECENT_OPS_FILE.exists():
            try:
                data = json.loads(RECENT_OPS_FILE.read_text(encoding="utf-8")) or {}
            except Exception:
                data = {}
        backups = data.get("backups", {})
        if not isinstance(backups, dict):
            backups = {}
        backups[host_id] = int(time.time())
        data["backups"] = backups
        RECENT_OPS_FILE.write_text(json.dumps(data), encoding="utf-8")
    except Exception:
        pass


def record_upgrade_request(target: str) -> None:
    try:
        private_dir(CACHE_DIR)
        data: dict[str, Any] = {}
        if RECENT_OPS_FILE.exists():
            try:
                data = json.loads(RECENT_OPS_FILE.read_text(encoding="utf-8")) or {}
            except Exception:
                data = {}
        upgrades = data.get("upgrades", {})
        if not isinstance(upgrades, dict):
            upgrades = {}
        upgrades[target.lower()] = int(time.time())
        data["upgrades"] = upgrades
        RECENT_OPS_FILE.write_text(json.dumps(data), encoding="utf-8")
    except Exception:
        pass


def record_power_cycle_request(mac: str, port_idx: int) -> None:
    try:
        private_dir(CACHE_DIR)
        data: dict[str, Any] = {}
        if RECENT_OPS_FILE.exists():
            try:
                data = json.loads(RECENT_OPS_FILE.read_text(encoding="utf-8")) or {}
            except Exception:
                data = {}
        cycles = data.get("power_cycles", {})
        if not isinstance(cycles, dict):
            cycles = {}
        key = f"{mac.lower()}_{port_idx}"
        cycles[key] = int(time.time())
        data["power_cycles"] = cycles
        RECENT_OPS_FILE.write_text(json.dumps(data), encoding="utf-8")
    except Exception:
        pass


